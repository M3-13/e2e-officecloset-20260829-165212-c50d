# Kopiere diese Datei nach `.env` und passe die Werte an.

# Datenbank-URL. Standard ist eine lokale SQLite-Datei.
DATABASE_URL=sqlite:///./wardrobe.db

# Signier-Schlüssel für JWTs. OPTIONAL: ist er nicht gesetzt, erzeugt das
# Backend bei jedem Start einen frischen, zufälligen Schlüssel. Für eine
# stabile Session über Neustarts hinweg hier einen festen Wert eintragen,
# z. B.: `py -c "import secrets; print(secrets.token_hex(32))"`.
SECRET_KEY=

# Erlaubte Frontend-Origin für CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Verzeichnis für hochgeladene Bilder (relativ zum Repo-Root).
UPLOAD_DIR=backend/uploads

# Maximalgröße eines Uploads (Angabe wie 5MB oder 512KB).
MAX_UPLOAD_SIZE=5MB
