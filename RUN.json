{
  "runcontract": 1,
  "services": [
    {
      "name": "backend",
      "dir": ".",
      "stack": "python",
      "kind": "server",
      "install": [
        ["${python}", "-m", "pip", "install", "-q", "-r", "backend/requirements.txt"]
      ],
      "start": [
        "${python}", "-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--port", "${PORT}"
      ],
      "port": 8000,
      "port_env": "PORT",
      "health": { "path": "/api/v1/health", "expect_status": [200] },
      "env": {
        "DATABASE_URL": { "dev": "sqlite:///./wardrobe.db" },
        "SECRET_KEY": { "generate": "hex", "bytes": 32 },
        "FRONTEND_ORIGIN": { "dev": "http://localhost:5173" },
        "UPLOAD_DIR": { "dev": "backend/uploads" },
        "MAX_UPLOAD_SIZE": { "dev": "5MB" }
      }
    }
  ]
}
