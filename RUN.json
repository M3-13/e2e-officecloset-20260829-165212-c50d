{
  "runcontract": 1,
  "services": [
    {
      "name": "frontend",
      "dir": "frontend",
      "stack": "web-vite",
      "kind": "server",
      "install": [
        [
          "npm",
          "ci"
        ]
      ],
      "build": [
        [
          "npm",
          "ci"
        ],
        [
          "npm",
          "run",
          "build"
        ]
      ],
      "start": [
        "npm",
        "run",
        "dev",
        "--",
        "--port",
        "${PORT}"
      ],
      "port": 5173,
      "port_env": "PORT",
      "health": {
        "path": "/",
        "expect_status": [
          200
        ]
      },
      "env": {
        "VITE_API_URL": {
          "dev": "http://localhost:8000/api/v1"
        },
        "VITE_BACKEND_URL": {
          "dev": "http://localhost:8000"
        }
      }
    },
    {
      "name": "backend",
      "dir": ".",
      "stack": "python",
      "kind": "server",
      "install": [
        [
          "${python}",
          "-m",
          "pip",
          "install",
          "-q",
          "-r",
          "backend/requirements.txt"
        ]
      ],
      "start": [
        "${python}",
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--port",
        "${PORT}"
      ],
      "port": 8000,
      "port_env": "PORT",
      "health": {
        "path": "/api/v1/health",
        "expect_status": [
          200
        ]
      },
      "env": {
        "DATABASE_URL": {
          "dev": "sqlite:///./wardrobe.db"
        },
        "SECRET_KEY": {
          "generate": "hex",
          "bytes": 32
        },
        "FRONTEND_ORIGIN": {
          "dev": "http://localhost:5173"
        },
        "UPLOAD_DIR": {
          "dev": "backend/uploads"
        },
        "MAX_UPLOAD_SIZE": {
          "dev": "5MB"
        }
      }
    }
  ]
}
